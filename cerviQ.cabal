cabal-version:       2.2

name:                cerviQ
version:             0.1.0.0
-- synopsis:
-- description:
homepage:            https://github.com/githubuser/cerviQ#readme
license:             BSD-3-Clause
license-file:        LICENSE
author:              Author name here
maintainer:          example@example.com
copyright:           2026 Author name here
category:            Web
build-type:          Simple
extra-source-files:  README.md
                     CHANGELOG.md


common cerviq-common
  other-modules:
    App
    Types
    Movement
    Collision
    Controller
    Input
    Game
    Agent
    AgentRegistry
    Config
    Maps
    Scenario
    Scenarios
    Evaluation
    QLearning
    QLearning.Core
    QLearning.Debug
    QLearning.V1
    QLearning.V2
    QLearning.V3
    QLearning.V4
    Render
    Training
    TrainingEnvironment
    TestData
    PlayGui
    Gui

  default-language:    Haskell2010

  build-depends:
    base >= 4.7 && < 5,
    containers,
    random,
    gloss,
    time ^>=1.12.2

  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-record-updates
                       -Wincomplete-uni-patterns
                       -Wmissing-home-modules
                       -Wpartial-fields
                       -Wredundant-constraints
                       -Wno-missing-export-lists
                       -threaded
                       -O2


executable cerviQ
  import:              cerviq-common
  hs-source-dirs:      src
  main-is:             Main.hs


executable cerviq-train-v4
  import:              cerviq-common
  hs-source-dirs:      app
                       src
  main-is:             TrainV4.hs


source-repository head
  type:     git
  location: https://github.com/githubuser/cerviQ